# Copy to D:\TrainingsAppGPT\.env.coach.local (ignored by Git).
# Server only: never use EXPO_PUBLIC_ for provider secrets.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Optional; defaults work with the same OpenRouter account key.
OPENROUTER_VISION_MODEL=google/gemini-2.5-flash
OPENROUTER_TRANSCRIPTION_MODEL=openai/whisper-large-v3
COACH_LOCAL_PORT=8096

# Required only for a public deployment of api/coach-chat.js:
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# COACH_ALLOWED_ORIGINS=https://your-app.example
