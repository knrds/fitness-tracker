# Copy to D:\TrainingsAppGPT\.env.coach.local (ignored by Git).
# Server only: never use EXPO_PUBLIC_ for provider secrets.
# Recommended Plan Mode models (JSON schema adherence & sports science):
# openai/gpt-5.6-luna or z-ai/glm-5.3-flash
OPENROUTER_MODEL=openai/gpt-5.6-luna

# Recommended Fast Mode model (quick tips & general advice):
# deepseek/deepseek-v4-flash-0731 or openai/gpt-4o-mini
OPENROUTER_FAST_MODEL=deepseek/deepseek-v4-flash-0731

# Optional; defaults work with the same OpenRouter account key.
OPENROUTER_VISION_MODEL=google/gemini-2.5-flash
OPENROUTER_TRANSCRIPTION_MODEL=openai/whisper-large-v3-turbo
COACH_LOCAL_PORT=8096

# Required only for a public deployment of api/coach-chat.js:
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# COACH_ALLOWED_ORIGINS=https://your-app.example

# Public endpoints require verified Auth or a scoped server-signed beta session.
# ALLOW_PROTOTYPE_COACH is ignored on public deployments.
# For development without Supabase use the loopback-only coach:local server.
# Its server-injected identity is disabled in production and Vercel deployments.

# Distributed quota foundation remains OFF until a reviewed server store is wired.
# No default quota policy/enrollment is installed by database/coach-quota.sql.
# SQL functions are private; the provisional Supabase transport needs a separate
# service-only bridge. Never expose private tables/functions to browser clients.
COACH_QUOTA_ENABLED=false
# COACH_QUOTA_STORE=supabase-rpc
# COACH_QUOTA_HASH_SECRET=<independent random server secret, at least 32 bytes>
# SUPABASE_SECRET_KEY=<server only, never EXPO_PUBLIC>
# Unit caps bound provider attempts; measured currency budgets remain a release gate.

