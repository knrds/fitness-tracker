# Supabase Configuration
# Copy this file to .env and fill in your Supabase project credentials.
# In Expo, variables prefixed with EXPO_PUBLIC_ are accessible in client code.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional Coach Chat LLM proxy endpoint.
# Web defaults to the same-origin Vercel function at /api/coach-chat.
# Do not put raw provider API keys in the mobile app.
EXPO_PUBLIC_COACH_CHAT_ENDPOINT=
# Model and provider key belong only on the server (see api/.env.example).
# Local browser preview: pnpm build, then pnpm coach:local.
# Native devices need an HTTPS backend URL above; localhost refers to the device.
