# Supabase Configuration
# Copy this file to .env and fill in your Supabase project credentials.
# In Expo, variables prefixed with EXPO_PUBLIC_ are accessible in client code.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional Coach Chat LLM proxy endpoint.
# Web defaults to the same-origin Vercel function at /api/coach-chat.
# Do not put raw provider API keys in the mobile app.
EXPO_PUBLIC_COACH_CHAT_ENDPOINT=
EXPO_PUBLIC_COACH_MODEL=

# Vercel serverless function variables (configure in Vercel, do not expose in Expo).
# Provider selection:
# LLM_PROVIDER=openrouter|groq|gemini|auto
# LLM_FALLBACK_PROVIDERS=groq,gemini
# LLM_ALLOW_PROVIDER_FALLBACK=true
# LLM_TIMEOUT_MS=20000
#
# Optional global model override:
# LLM_MODEL=
#
# OpenRouter:
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_SITE_URL=https://your-vercel-domain.vercel.app
# OPENROUTER_MODEL=google/gemini-2.5-flash:free
#
# Groq:
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=openai/gpt-oss-120b
#
# Gemini / Google AI Studio:
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-2.5-flash
