# HTTPS staging web preview only. Never copy production credentials.
# Replace placeholders locally; leave Supabase variables absent for guest-only tests.
EXPO_PUBLIC_SUPABASE_URL=https://<STAGING_PROJECT_REF>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<INSERT_LOCALLY_PUBLIC_ANON_KEY>
# Explicitly use the Vercel handler. Otherwise configured Supabase selects its Edge Function.
EXPO_PUBLIC_COACH_CHAT_ENDPOINT=/api/coach-chat
# Native builds require an absolute HTTPS endpoint instead of this relative web URL.
# No OPENROUTER_API_KEY, service_role, or private credential belongs in this file.
